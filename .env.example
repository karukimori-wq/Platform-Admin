# Platform Admin

# Target authentication: Clerk.
# Publishable key is safe for the browser; secret key must remain server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Transitional Supabase Snapshot Mode:
# Keep these only while operational snapshots still live in Supabase.
# Remove after D1 cutover and reconciliation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Basic Auth transition only.
# Do not use as the target production authentication mechanism.
PLATFORM_ADMIN_API_TOKEN=
PLATFORM_ADMIN_USERNAME=admin

# Cross-app monitoring
# Velvet has no guessed default URL: configure the deployed Professional App URL explicitly.
VELVET_BASE_URL=
GROWTH_ENGINE_BASE_URL=https://growth-engine-ruby-nine.vercel.app
SNS_PLANNER_BASE_URL=https://sns-planner.illusionddt.chatgpt.site

# Configure additional app base URLs in the deployment environment as required.
COMMUNICATION_PLANNER_BASE_URL=
AI_PLATFORM_CORE_BASE_URL=
NUMERIA_STUDIO_BASE_URL=
