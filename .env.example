# Platform Admin

# Mock Mode:
# Leave SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY empty to use lib/mock-data.ts.

# Supabase Snapshot Mode:
# Set both values to read operational snapshots from Supabase REST API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only when Supabase Snapshot Mode is enabled.
# Used as the Basic Auth password.
PLATFORM_ADMIN_API_TOKEN=

# Optional. Defaults to "admin" when unset.
# Used as the Basic Auth username.
PLATFORM_ADMIN_USERNAME=admin

# Cross-app monitoring
# Velvet has no guessed default URL: configure the deployed Professional App URL explicitly.
VELVET_BASE_URL=
GROWTH_ENGINE_BASE_URL=https://growth-engine-ruby-nine.vercel.app
SNS_PLANNER_BASE_URL=https://sns-planner.illusionddt.chatgpt.site
