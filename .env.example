# Platform Admin

# Production persistence
PLATFORM_ADMIN_PERSISTENCE_DRIVER=d1

# API token for admin APIs and automation.
PLATFORM_ADMIN_API_TOKEN=

# Supabase fallback mode:
# Set both values only when using the legacy fallback snapshot store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to "admin" when unset.
# Used for Basic Auth compatibility. Human operator auth is not final.
PLATFORM_ADMIN_USERNAME=admin

# Cross-app monitoring
PLATFORM_ADMIN_BASE_URL=https://platform-admin.karukimori.workers.dev
AI_PLATFORM_CORE_BASE_URL=https://ai-platform-core.karukimori.workers.dev
COMMUNICATION_PLANNER_BASE_URL=https://communication-planner.karukimori.workers.dev
GROWTH_ENGINE_BASE_URL=https://growth-engine-ruby-nine.vercel.app
SNS_PLANNER_BASE_URL=https://sns-planner.illusionddt.chatgpt.site
NUMERIA_STUDIO_BASE_URL=https://numeria-studio.illusionddt.chatgpt.site

# Velvet has no guessed default URL: configure the deployed Professional App URL explicitly.
VELVET_BASE_URL=
