{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "platform-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "platform-admin-snapshots"
    }
  ],
  "observability": {
    "enabled": true
  }
}
