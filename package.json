{
  "name": "platform-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "cf:check": "wrangler check",
    "cf:whoami": "wrangler whoami",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:list": "wrangler d1 list",
    "d1:schema:local": "wrangler d1 execute platform-admin-snapshots --local --file ./database/d1-schema.sql",
    "d1:schema:remote": "wrangler d1 execute platform-admin-snapshots --remote --file ./database/d1-schema.sql",
    "d1:verify:local": "wrangler d1 execute platform-admin-snapshots --local --command \"SELECT name FROM sqlite_schema WHERE type='table' ORDER BY name\"",
    "d1:verify:remote": "wrangler d1 execute platform-admin-snapshots --remote --command \"SELECT name FROM sqlite_schema WHERE type='table' ORDER BY name\"",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.31.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2",
    "wrangler": "^4.32.0"
  }
}
